# Normalise on commit, keep each platform's working copy natural.
* text=auto

# Source and docs: LF in the repository.
*.rs      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.mjs     text eol=lf
*.html    text eol=lf
*.toml    text eol=lf

# Windows build scripts keep CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binaries
*.png     binary
*.ico     binary
*.icns    binary
